{
  "name": "knot",
  "version": "0.1.0",
  "private": true,
  "description": "Draw a closed rope in 3D; the app works out which knot you tied, and shows the maths.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
